<Window x:Class="DollarConverterApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DollarConverterApp"
        mc:Ignorable="d"
        Title="Conversor de Dólar" Height="450" Width="400"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F7">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="Conversor USD/BRL" 
                   FontSize="24" FontWeight="Bold" 
                   HorizontalAlignment="Center" Margin="0,0,0,30"
                   Foreground="#333333"/>

        <!-- USD Section -->
        <Border Grid.Row="1" Background="White" CornerRadius="10" Padding="15" Margin="0,0,0,15"
                Effect="{DynamicResource ShadowEffect}">
            <StackPanel>
                <TextBlock Text="USD - Dólar Americano" Foreground="#666666" Margin="0,0,0,5"/>
                <TextBox Text="{Binding UsdAmount, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}" 
                         FontSize="28" FontWeight="SemiBold" BorderThickness="0"
                         HorizontalContentAlignment="Right"/>
            </StackPanel>
        </Border>

        <!-- Exchange Icon -->
        <Border Grid.Row="2" Background="#E1E1E1" Width="40" Height="40" CornerRadius="20" 
                HorizontalAlignment="Center" Margin="0,-10,0,-10" Panel.ZIndex="1">
            <TextBlock Text="↕" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20"/>
        </Border>

        <!-- BRL Section -->
        <Border Grid.Row="3" Background="White" CornerRadius="10" Padding="15" Margin="0,15,0,20"
                Effect="{DynamicResource ShadowEffect}">
            <StackPanel>
                <TextBlock Text="BRL - Real Brasileiro" Foreground="#666666" Margin="0,0,0,5"/>
                <TextBox Text="{Binding BrlAmount, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}" 
                         FontSize="28" FontWeight="SemiBold" BorderThickness="0"
                         HorizontalContentAlignment="Right"/>
            </StackPanel>
        </Border>

        <!-- Info Section -->
        <StackPanel Grid.Row="4" VerticalAlignment="Bottom">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                <TextBlock Text="Cotação Atual: " Foreground="#666666"/>
                <TextBlock Text="{Binding CurrentRate, StringFormat=C2, ConverterCulture=pt-BR}" FontWeight="Bold" Foreground="#333333"/>
            </StackPanel>
            
            <TextBlock Text="{Binding LastUpdated, StringFormat='Atualizado em: {0}'}" 
                       HorizontalAlignment="Center" Foreground="#999999" FontSize="12"/>
        </StackPanel>

    </Grid>

    <Window.Resources>
        <DropShadowEffect x:Key="ShadowEffect" BlurRadius="10" ShadowDepth="2" Direction="270" Color="#E0E0E0" Opacity="0.5"/>
    </Window.Resources>
</Window>
